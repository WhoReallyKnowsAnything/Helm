<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- MemPalace hub: one `mempalace serve` process owns the palace writer lease so every
     session's mempalace-mcp can proxy to it. Not installed anywhere: launch-claude.sh
     (mempalace_hub_ensure) copies it to a temp file, replaces __MEMPALACE_BIN__ with the
     real binary path and runs `launchctl bootstrap gui/$UID` on the copy. The job lives
     until logout. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.whoreallyknowsanything.helm.mempalace-hub</string>
    <key>ProgramArguments</key>
    <array>
        <string>__MEMPALACE_BIN__</string>
        <string>serve</string>
        <string>--port</string>
        <string>8765</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/mempalace-hub.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mempalace-hub.log</string>
</dict>
</plist>
